<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Legal Billing — Connect Google</title>
<style>
  :root {
    --bg: #1e1e2e; --surface: #26263a; --border: #38385a;
    --text: #e2e2f0; --muted: #7a7a9a;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg); color: var(--text);
    display: flex; align-items: center; justify-content: center;
    min-height: 100vh; padding: 20px;
  }
  .card {
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 14px; padding: 28px; width: 100%; max-width: 360px;
  }
  .header {
    display: flex; align-items: center; gap: 12px;
    margin-bottom: 20px; padding-bottom: 20px; border-bottom: 1px solid var(--border);
  }
  .icon {
    width: 36px; height: 36px;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    border-radius: 9px; display: flex; align-items: center;
    justify-content: center; font-size: 18px; flex-shrink: 0;
  }
  .title  { font-size: 14px; font-weight: 600; }
  .sub    { font-size: 12px; color: var(--muted); margin-top: 1px; }
  h3      { font-size: 16px; font-weight: 600; margin-bottom: 6px; }
  .desc   { font-size: 13px; color: var(--muted); line-height: 1.55; margin-bottom: 22px; }
  .btn {
    display: flex; align-items: center; justify-content: center; gap: 10px;
    width: 100%; padding: 10px 16px; background: #fff; color: #3c4043;
    border: 1px solid #dadce0; border-radius: 8px; font-size: 14px; font-weight: 500;
    text-decoration: none; transition: background .15s, box-shadow .15s;
  }
  .btn:hover { background: #f8f9fa; box-shadow: 0 1px 4px rgba(0,0,0,.25); }
  .permissions {
    background: rgba(255,255,255,0.04); border: 1px solid var(--border);
    border-radius: 8px; padding: 12px 14px; margin-top: 16px;
  }
  .permissions-title { font-size: 11px; font-weight: 600; color: var(--muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.04em; }
  .permission-row { display: flex; align-items: flex-start; gap: 8px; margin-bottom: 6px; font-size: 12px; color: var(--muted); line-height: 1.4; }
  .permission-row:last-child { margin-bottom: 0; }
  .perm-icon { flex-shrink: 0; margin-top: 1px; }
  .policy-line {
    text-align: center; font-size: 11px; color: var(--muted); margin-top: 14px; line-height: 1.5;
  }
  .policy-line a { color: #6366f1; }
  .policy-line a:hover { text-decoration: underline; }
</style>
</head>
<body>
<div class="card">
  <div class="header">
    <div class="icon">⚖</div>
    <div>
      <div class="title">Legal Billing</div>
      <div class="sub">by Protomated</div>
    </div>
  </div>
  <h3>Connect Google Sheets</h3>
  <p class="desc">
    Sign in to allow Legal Billing to read and write your billing sheet.
    Your data stays in your own Google Drive.
  </p>
  <a class="btn" href="<%= authUrl %>">
    <svg width="18" height="18" viewBox="0 0 18 18" xmlns="http://www.w3.org/2000/svg">
      <path fill="#4285F4" d="M17.64 9.2c0-.637-.057-1.251-.164-1.84H9v3.481h4.844c-.209 1.125-.843 2.078-1.796 2.717v2.258h2.908C16.658 14.013 17.64 11.705 17.64 9.2z"/>
      <path fill="#34A853" d="M9 18c2.43 0 4.467-.806 5.956-2.18l-2.908-2.259c-.806.54-1.837.86-3.048.86-2.344 0-4.328-1.584-5.036-3.711H.957v2.332C2.438 15.983 5.482 18 9 18z"/>
      <path fill="#FBBC05" d="M3.964 10.71c-.18-.54-.282-1.117-.282-1.71s.102-1.17.282-1.71V4.958H.957C.347 6.173 0 7.548 0 9s.348 2.827.957 4.042l3.007-2.332z"/>
      <path fill="#EA4335" d="M9 3.58c1.321 0 2.508.454 3.44 1.345l2.582-2.58C13.463.891 11.426 0 9 0 5.482 0 2.438 2.017.957 4.958L3.964 7.29C4.672 5.163 6.656 3.58 9 3.58z"/>
    </svg>
    Sign in with Google
  </a>

  <div class="permissions">
    <div class="permissions-title">Permissions requested</div>
    <div class="permission-row">
      <span class="perm-icon">📋</span>
      <span><strong style="color:#c9c9e0">Google Sheets</strong> — read &amp; write your billing spreadsheet</span>
    </div>
    <div class="permission-row">
      <span class="perm-icon">📁</span>
      <span><strong style="color:#c9c9e0">Google Drive</strong> — create your billing sheet on first use (app-created files only)</span>
    </div>
    <div class="permission-row">
      <span class="perm-icon">👤</span>
      <span><strong style="color:#c9c9e0">Profile &amp; email</strong> — identify your account. Never used for marketing.</span>
    </div>
  </div>

  <p class="policy-line">
    By signing in you agree to Protomated's
    <a href="/privacy" target="_blank">Privacy Policy</a> and
    <a href="/terms" target="_blank">Terms of Service</a>.
    Your data stays in your own Google Drive.
  </p>
</div>
</body>
</html>
