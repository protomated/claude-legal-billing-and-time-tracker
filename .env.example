# HTTP MCP server — copy to .env and fill in before running

# Public URL of this server (no trailing slash). Used to build OAuth redirect URI.
SERVER_URL=https://billing.protomated.com

# Port the server listens on.
PORT=3000

# Google Web application OAuth credentials.
# Create at: Google Cloud Console → Credentials → OAuth client ID → Web application
# Add authorized redirect URI: ${SERVER_URL}/oauth/callback
# (For local testing you can also add: http://localhost:3000/oauth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Directory where per-attorney JSON files are stored.
# Mount a persistent Docker volume here so data survives redeploys.
DATA_DIR=/data
