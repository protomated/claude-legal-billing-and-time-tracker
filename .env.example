# HTTP MCP server — copy to .env and fill in before running

# Public URL of this server (no trailing slash). Used to build OAuth redirect URI.
SERVER_URL=https://billing.protomated.com

# Port the server listens on.
PORT=3000

# Google Web application OAuth credentials — used for each attorney's own
# Google sign-in (Sheets + Drive scope; Drive is drive.file only, needed to
# create the attorney's own billing sheet from the bundled template file).
# Create at: Google Cloud Console → Credentials → OAuth client ID → Web application
# Add authorized redirect URI: ${SERVER_URL}/oauth/callback
# (For local testing you can also add: http://localhost:3000/oauth/callback)
# Enable both the Google Sheets API and Google Drive API on this project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres connection string — stores attorney sessions and OAuth tokens.
# Matches the `postgres` service in docker-compose.yml when running locally.
DATABASE_URL=postgresql://user:pass@localhost:54333/legal_billing
