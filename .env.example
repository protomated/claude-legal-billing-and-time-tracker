# HTTP MCP server — copy to .env and fill in values before running

# Public URL of this server (no trailing slash). Used to build OAuth redirect URI.
SERVER_URL=https://billing.protomated.com

# Port the server listens on (Dokploy maps this to your domain)
PORT=3000

# Google Web application OAuth credentials.
# Create at: Google Cloud Console → Credentials → OAuth client ID → Web application
# Add redirect URI: ${SERVER_URL}/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Directory where per-attorney JSON files are stored.
# Mount a Docker volume here to persist data across restarts.
DATA_DIR=/data
